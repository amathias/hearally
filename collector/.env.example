# For running from source only. Everyone else runs `setup`, which saves its
# own settings; see README.md. Copy to .env and fill in. Never commit .env.
HEARALLY_API_URL=https://api.hearally.com
# This computer's device token, issued when it is paired with an account.
# Get one by running setup once (node src/cli.js setup) and copying
# device_token from the settings file it saves. It is a credential.
HEARALLY_DEVICE_TOKEN=
# One Plaud: the folder its recordings are exported into.
# Several Plauds: leave this unset and use HEARALLY_RECORDERS_FILE instead.
HEARALLY_WATCH_DIR=
# HEARALLY_RECORDERS_FILE=recorders.json
HEARALLY_STATE_FILE=.hearally-collector-state.json
# phone_call, in_person or unknown
HEARALLY_CAPTURE_MODE=unknown
